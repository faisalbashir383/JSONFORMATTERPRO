<!--@block:content-->
<article class="blog-content">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <a href="/blog/">Articles</a>
        <span>›</span>
        <a href="/blog/category/{{ post.category.slug|py }}/">{{ post.category.name|py }}</a>
        <span>›</span>
        <span>{{ post.title|py }}</span>
    </nav>

    <!-- Article Header -->
    <header style="margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid var(--color-border);">
        <span
            style="color: var(--color-primary); font-size: 0.875rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">
            {{ post.category.name|py }}
        </span>
        <h1 style="font-size: 2.5rem; font-weight: 700; margin: 1rem 0; line-height: 1.2;">{{ post.title|py }}</h1>
        <div
            style="display: flex; gap: 2rem; color: var(--color-text-secondary); font-size: 0.875rem; flex-wrap: wrap;">
            <span>📅 {{ post.published_at|date("F d, Y")|py }}</span>
            <span class="article-author">
                ✍️ {% if (post.author_profile_url|pytruth) %}<a href="{{ post.author_profile_url|py }}" target="_blank"
                    rel="noopener"
                    style="color: inherit; text-decoration: none; border-bottom: 1px dotted currentColor;">
                {{ post.author_name|py }}</a>{% else %}{{ post.author_name|py }}{% endif %}
            </span>
            <span>⏱️ {{ post.reading_time|py }} min read</span>
            <span>👁️ {{ post.views|py }} views</span>
            <span>🏷️ {{ post.category.name|py }}</span>
        </div>
    </header>

    <!-- Article Content -->
    <div class="content" itemscope itemtype="https://schema.org/Article">
        <meta itemprop="headline" content="{{ post.title|py }}">
        <meta itemprop="datePublished" content="{{ post.published_at|date('c')|py }}">
        <meta itemprop="dateModified" content="{{ post.updated_at|date('c')|py }}">
        <div itemprop="articleBody">
            {{ post.content|py|safe }}
        </div>
    </div>

    <!-- Tags -->
    {% if (post.tags|pytruth) %}
    <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
        <strong
            style="color: var(--color-text-secondary); font-size: 0.875rem; display: block; margin-bottom: 0.75rem;">
            🏷️ Tags:
        </strong>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            {% for tag in post.get_tags_list %}
            <span
                style="display: inline-block; background: var(--color-surface-alt); padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.85rem;">
                {{ tag|py }}
            </span>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- Share Buttons -->
    <div class="share-buttons">
        <strong style="color: var(--color-text-secondary); font-size: 0.875rem; line-height: 2.5;">Share:</strong>
        <a href="https://twitter.com/intent/tweet?text={{ post.title|urlencode|py }}&url=https://jsonformatterspro.com/blog/{{ post.slug }}/"
            target="_blank" rel="noopener" class="share-btn share-twitter">
            Twitter
        </a>
        <a href="https://www.linkedin.com/sharing/share-offsite/?url=https://jsonformatterspro.com/blog/{{ post.slug }}/"
            target="_blank" rel="noopener" class="share-btn share-linkedin">
            LinkedIn
        </a>
        <a href="https://www.facebook.com/sharer/sharer.php?u=https://jsonformatterspro.com/blog/{{ post.slug }}/"
            target="_blank" rel="noopener" class="share-btn share-facebook">
            Facebook
        </a>
    </div>

    <!-- Previous / Next Article Navigation -->
    {% if (previous_post|pytruth) or (next_post|pytruth) %}
    <nav class="article-navigation"
        style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            {% if (previous_post|pytruth) %}
            <a href="/blog/{{ previous_post.slug }}/"
                style="display: block; padding: 1.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); text-decoration: none; transition: all 0.2s;"
                onmouseover="this.style.borderColor='var(--color-primary)'; this.style.transform='translateY(-2px)'"
                onmouseout="this.style.borderColor='var(--color-border)'; this.style.transform=''">
                <span
                    style="display: block; font-size: 0.75rem; color: var(--color-text-secondary); margin-bottom: 0.5rem;">
                    ← Previous Article
                </span>
                <span
                    style="display: block; font-size: 0.95rem; font-weight: 600; color: var(--color-text); line-height: 1.4;">
                    {{ previous_post.title|truncatewords(10)|py }}
                </span>
            </a>
            {% else %}
            <div></div>
            {% endif %}

            {% if (next_post|pytruth) %}
            <a href="/blog/{{ next_post.slug }}/"
                style="display: block; padding: 1.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); text-decoration: none; text-align: right; transition: all 0.2s;"
                onmouseover="this.style.borderColor='var(--color-primary)'; this.style.transform='translateY(-2px)'"
                onmouseout="this.style.borderColor='var(--color-border)'; this.style.transform=''">
                <span
                    style="display: block; font-size: 0.75rem; color: var(--color-text-secondary); margin-bottom: 0.5rem;">
                    Next Article →
                </span>
                <span
                    style="display: block; font-size: 0.95rem; font-weight: 600; color: var(--color-text); line-height: 1.4;">
                    {{ next_post.title|truncatewords(10)|py }}
                </span>
            </a>
            {% endif %}
        </div>
    </nav>
    {% endif %}
</article>

<!-- Related Posts -->
{% if (related_posts|pytruth) %}
<section style="max-width: 800px; margin: 4rem auto 0;">
    <h3 style="font-size: 1.75rem; margin-bottom: 1.5rem; font-weight: 600;">📚 Related Articles</h3>
    <div style="display: grid; gap: 1.5rem;">
        {% for related in related_posts %}
        <article
            style="background: var(--color-surface); padding: 1.5rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border); transition: all var(--transition-fast);"
            onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px var(--color-shadow)'"
            onmouseout="this.style.transform=''; this.style.boxShadow=''">
            <span style="color: var(--color-primary); font-size: 0.75rem; font-weight: 500; text-transform: uppercase;">
                {{ related.category.name|py }}
            </span>
            <h4 style="font-size: 1.25rem; margin: 0.5rem 0; font-weight: 600;">
                <a href="/blog/{{ related.slug }}/" style="color: var(--color-text); text-decoration: none;">
                    {{ related.title|py }}
                </a>
            </h4>
            <p style="color: var(--color-text-secondary); font-size: 0.875rem; margin-top: 0.5rem;">
                {{ related.excerpt|truncatewords(20)|py }}
            </p>
            <div
                style="display: flex; gap: 1rem; margin-top: 1rem; font-size: 0.75rem; color: var(--color-text-secondary);">
                <span>⏱️ {{ related.reading_time|py }} min</span>
                <span>👁️ {{ related.views|py }} views</span>
            </div>
        </article>
        {% endfor %}
    </div>
</section>
{% endif %}
