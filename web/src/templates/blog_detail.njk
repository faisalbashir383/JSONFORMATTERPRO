<!-- Enhanced Article Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "{{ post.title|escapejs|py }}",
  "description": "{{ post.meta_description|escapejs|py }}",
  "image": "https://jsonformatterspro.com/static/images/blog-default.png",
  "datePublished": "{{ post.published_at|date('c')|py }}",
  "dateModified": "{{ post.updated_at|date('c')|py }}",
  "author": {
    "@type": "Person",
    "name": "{{ post.author_name|py }}",
    "url": "{{ post.author_profile_url|default(SITE_URL)|py }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "JSON Formatter Pro",
    "logo": {
      "@type": "ImageObject",
      "url": "https://jsonformatterspro.com/static/images/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://jsonformatterspro.com/blog/{{ post.slug }}/"
  },
  "articleSection": "{{ post.category.name|escapejs|py }}",
  "keywords": "{{ post.meta_keywords|escapejs|py }}",
  "wordCount": {{ post.content|wordcount|py }},
  "timeRequired": "PT{{ post.reading_time|py }}M",
  "articleBody": "{{ post.content|striptags|escapejs|truncatewords(50)|py }}"
}
</script>

<!-- BreadcrumbList Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
