---
// /blog/, /blog/page/N/, /blog/category/<slug>/[page/N/] and /blog/<slug>/, built from Supabase.
import { hasData } from '../../lib/db';
import { blogDetailPages, blogListPages } from '../../lib/views';
import { renderTemplate } from '../../lib/render';

export async function getStaticPaths() {
  if (!hasData) return [];
  const list = (await blogListPages()).map((p) => ({ ...p, template: 'blog_list' }));
  const detail = (await blogDetailPages()).map((p) => ({ ...p, template: 'blog_detail' }));
  return [...list, ...detail].map(({ url, context, template }) => ({
    params: { path: url.replace(/^\/blog\/|\/$/g, '') || undefined },
    props: { context, template },
  }));
}

const { context, template } = Astro.props;
const html = renderTemplate(template, context);
---
<Fragment set:html={html} />
