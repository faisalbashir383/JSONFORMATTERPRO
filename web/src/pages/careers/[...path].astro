---
// /careers/ and /careers/<slug>/, built from Supabase.
import { hasData } from '../../lib/db';
import { careersContext, jobDetailPages } from '../../lib/views';
import { renderTemplate } from '../../lib/render';

export async function getStaticPaths() {
  if (!hasData) return [];
  const pages = [
    { url: '/careers/', context: await careersContext(), template: 'careers' },
    ...(await jobDetailPages()).map((p) => ({ ...p, template: 'job-detail' })),
  ];
  return pages.map(({ url, context, template }) => ({
    params: { path: url.replace(/^\/careers\/|\/$/g, '') || undefined },
    props: { context, template, url },
  }));
}

const { context, template, url } = Astro.props;
const html = renderTemplate(template, context, url);
---
<Fragment set:html={html} />
