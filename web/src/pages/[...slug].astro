---
// Every static tool page: one route per entry in data/routes.json, rendered from
// pages-html/<page>.html inside layouts/base.html.
import layout from '../layouts/base.html?raw';
import routes from '../data/routes.json';
import { parseBlocks, renderPage, withSeoDefaults } from '../lib/blocks';

const pages = import.meta.glob<string>('../pages-html/*.html', { query: '?raw', import: 'default', eager: true });

export function getStaticPaths() {
  return routes.map((r) => ({
    params: { slug: r.path.replace(/^\/|\/$/g, '') || undefined },
    props: { page: r.page, path: r.path },
  }));
}

const { page, path } = Astro.props;
const html = renderPage(layout, withSeoDefaults(parseBlocks(pages[`../pages-html/${page}.html`]), path));
---
<Fragment set:html={html} />
